# Back up the Stoa Postgres once a day (installed by ops/vm/setup.sh and deploy.sh).
[Unit]
Description=Back up the Stoa Postgres daily, before the 00:00 UTC pipeline run

[Timer]
# The VM starts at 23:40 UTC; idle-stop keeps it up for at least 30 minutes after boot.
OnCalendar=*-*-* 23:50:00 UTC

[Install]
WantedBy=timers.target
