*.part

# Data is versioned with DVC, never git.
data/
*.egg-info/

# Documentation lives in Markdown or LaTeX (tracked). Binary documents are build
# outputs or reference copies and are never tracked.
*.docx
*.doc
*.pdf
*.pptx
*.xlsx

# LaTeX build output (compile with -outdir=build)
build/
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# macOS
.DS_Store
