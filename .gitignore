.venv/
# Local secrets (SMTP login for Airflow alerts, AIRFLOW_UID). Never commit.
.env
# Service account keys (e.g. the one dvc_push uses). Never commit.
.secrets/
__pycache__/
.pytest_cache/
.ruff_cache/
*.part

# Data is versioned with DVC, never git. data/.gitignore (written by `dvc add`) keeps the
# data folders out of git; only their pointer files (data/*.dvc) are committed.
*.egg-info/

# Documentation lives in Markdown or LaTeX (tracked). Binary documents are build
# outputs or reference copies and are never tracked.
*.docx
*.doc
*.pdf
*.pptx
*.xlsx

# LaTeX build output (compile with -outdir=build)
build/
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# macOS
.DS_Store

# Personal scratch space for files that never go in the repo.
dump/
