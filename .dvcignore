# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Finder metadata and half-finished downloads (src/ingest writes *.part, then renames).
.DS_Store
*.part
# Python caches: written whenever code runs, so they would make code folders in dvc.yaml look changed.
__pycache__/
*.pyc
