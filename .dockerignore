# The image only needs pyproject.toml (see Dockerfile); the repo is mounted at run time.
# Keeping data and environments out of the build context avoids sending gigabytes to Docker.
data/
.venv/
.git/
# DVC's local cache is a second copy of data/.
.dvc/cache/
**/__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
docs/**/build/
*.pdf
*.docx
.DS_Store
dump/
# Service account keys are mounted at run time, never baked into the image.
.secrets/
